Options -Indexes
DirectoryIndex index.php index.html

# Many Apache setups (including some cPanel/shared-hosting PHP handlers)
# don't pass the Authorization header through to PHP by default. This
# doesn't depend on mod_rewrite, so it works even where that's disabled.
<IfModule mod_setenvif.c>
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS outside localhost-style development hosts.
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block access to sensitive directories.
RewriteRule ^(includes|database)(/|$) - [F,L]
RewriteRule (^|/)\\. - [F,L]
</IfModule>
